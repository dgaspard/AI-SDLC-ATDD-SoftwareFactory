{
  "permissions": {
    "deny": [
      "Edit(./spec/**)",
      "Edit(./docs/specs/**)",
      "Edit(./.claude/**)",
      "Edit(./.github/workflows/guard.yml)",
      "Edit(./.github/CODEOWNERS)",
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./tools/petclinic/suite.mjs)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-paths.mjs\"" }
        ]
      }
    ]
  }
}
