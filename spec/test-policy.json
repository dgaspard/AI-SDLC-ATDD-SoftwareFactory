{
  "description": "Factory mechanism verification only; consumer application gates remain independently owned.",
  "suites": {
    "guard": {
      "name": "Guard",
      "cmd": "node",
      "args": [
        "guard/check.js"
      ]
    },
    "harness": {
      "name": "harness",
      "cmd": "node",
      "args": [
        "--test",
        "--test-reporter=spec",
        "--test-concurrency=1",
        "tests/harness/*.test.js"
      ]
    },
    "boundary": {
      "name": "boundary",
      "cmd": "node",
      "args": [
        "--test",
        "--test-reporter=spec",
        "--test-concurrency=1",
        "tests/factory/*.test.js",
        "../tools/factory/self-test.mjs"
      ]
    },
    "evidence": {
      "name": "evidence",
      "cmd": "node",
      "args": [
        "--test",
        "--test-reporter=spec",
        "--test-concurrency=1",
        "tests/evidence/*.test.js"
      ]
    },
    "dora": {
      "name": "dora",
      "cmd": "node",
      "args": [
        "--test",
        "--test-reporter=spec",
        "--test-concurrency=1",
        "tests/dora/*.test.js"
      ]
    },
    "github": {
      "name": "github",
      "cmd": "node",
      "args": [
        "--test",
        "--test-reporter=spec",
        "--test-concurrency=1",
        "../tools/github/agent.test.mjs"
      ]
    }
  },
  "tiers": {
    "fast": {
      "always": [
        "guard",
        "harness",
        "boundary",
        "evidence",
        "dora",
        "github"
      ],
      "suites": [
        "guard",
        "harness",
        "boundary",
        "evidence",
        "dora",
        "github"
      ]
    },
    "full": {
      "suites": [
        "guard",
        "harness",
        "boundary",
        "evidence",
        "dora",
        "github"
      ]
    }
  },
  "rules": {
    "list": []
  }
}
