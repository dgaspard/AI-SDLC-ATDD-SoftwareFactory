{
  "name": "ai-sdlc-software-factory",
  "version": "1.0.0",
  "private": true,
  "description": "Reusable consumer verification and evidence mechanisms",
  "scripts": {
    "test": "npm --prefix spec test",
    "test:fast": "node spec/run-all.js --tier fast",
    "test:gate": "node spec/run-all.js --tier full --cache",
    "test:suite": "node spec/run-all.js --suite",
    "test:plan": "node spec/run-all.js --tier fast --dry-run",
    "test:verify": "node spec/run-all.js --verify",
    "evidence:change": "node tools/evidence/change-evidence.mjs",
    "evidence:verify": "node tools/evidence/change-evidence.mjs --verify",
    "metrics:dora": "node tools/dora/dora-metrics.mjs"
  },
  "engines": {
    "node": "22 || 24 || >=26"
  }
}
